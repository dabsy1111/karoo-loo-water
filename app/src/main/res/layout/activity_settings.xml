<?xml version="1.0" encoding="utf-8"?>
<!-- Settings screen, opened from the Karoo's Extensions page. Sized for gloved taps. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/screen_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/settings_data" />

        <TextView
            android:id="@+id/data_built"
            style="@style/InfoLine" />

        <TextView
            android:id="@+id/data_downloaded"
            style="@style/InfoLine" />

        <TextView
            android:id="@+id/data_source"
            style="@style/InfoLine"
            android:textColor="@color/screen_subtext"
            android:textSize="14sp" />

        <Button
            android:id="@+id/reload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="56dp"
            android:text="@string/settings_reload"
            android:textSize="18sp" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/settings_types" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/settings_types_hint"
            android:textColor="@color/screen_subtext"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/type_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
